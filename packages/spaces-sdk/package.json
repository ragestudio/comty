	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@timephy/rnnoise-wasm": "^1.0.0",
		"axios": "^1.20.0",
		"mediasoup-client": "^3.24.4",
		"tinybase": "^10.0.1",
		"tseep": "^1.3.1",
		"valibot": "^1.5.0",
		"zustand": "^5.0.15",
		"@comty/shared": "workspace:*",
		"comty.js": "workspace:*",
		"@linebridge/client": "workspace:*"
	},
	"devDependencies": {
		"react": "^19.1.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.2.18",
		"typescript": "^7.0.2"
	},
	"exports": {
		".": "./src/index.ts",
		"./classes": "./src/classes/index.ts",
		"./classes/*": "./src/classes/*",
		"./rtc": "./src/rtc/index.ts",
		"./rtc/audio": "./src/rtc/audio/index.ts",
