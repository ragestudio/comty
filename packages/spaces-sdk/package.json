		"./group": "./src/group/index.ts",
		"./group/*": "./src/group/*",
		"./chat/types": "./src/chat/types.ts",
		"./chat/session": "./src/chat/session.ts",
		"./chat": "./src/chat/index.ts",
		"./chat/*": "./src/chat/*",
		"./groupsList": "./src/groupsList/index.ts",
		"./groupsList/*": "./src/groupsList/*",
		"./events": "./src/events/index.ts",
		"./events/*": "./src/events/*",
		"./db": "./src/db/index.ts",
		"./db/react": "./src/db/useLiveQuery.ts",
		"./db/persister-web": "./src/db/persister-web.ts"
	}
}
