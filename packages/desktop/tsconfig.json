{
	"compilerOptions": {
		"target": "es2024",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2024", "DOM"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
}
