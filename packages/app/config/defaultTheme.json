{
	"defaultVars": {
		"fontScale": "1",
		"backgroundBlur": "0px",
		"colorPrimary": "#f8575c",
		"app-color": "#f8575c",
		"danger-color": "#f8575c",
		"backgroundColorTransparency": "0.8",
		"fontFamily": "'Noto Sans', sans-serif",
		"layoutMargin": "unset",
		"layoutPadding": "10px 10px 10px 10px",
		"borderRadius": "8px",
		"text-color-white": "#d8d8d8",
		"text-color-black": "#000000",
		"page-transition-duration": "150ms",
		"backgroundSize": "cover",
		"backgroundPosition": "center",
		"backgroundRepeat": "no-repeat",
		"backgroundAttachment": "fixed",
		"top-bar-height": "52px",
		"bottom-bar-height": "80px",
		"compact-mode": false,

		"backgroundColorPrimary": "var(--background-color-primary)",
		"backgroundColorAccent": "var(--background-color-accent)"
	},
	"defaultVariant": "dark",
	"variants": {
		"light": {
			"textColor": "#000000",
			"textColorContrast": "#d2d2d2",

			"bg_color_1": "255, 255, 255",
			"bg_color_2": "200, 200, 200",
			"bg_color_3": "150, 150, 150",
			"bg_color_4": "100, 100, 100",
			"bg_color_5": "45, 45, 45",
			"bg_color_6": "0, 0, 0",
			"text-color": "var(--text-color-black)",
			"svg-color": "var(--text-color)",
			"disabled-color": "#d2d2d2",
			"layoutBackgroundColor": "255, 255, 255",
			"layout-background-contrast": "38, 38, 38",
			"background-color-primary": "#ffffff",
			"background-color-primary-2": "#f0f0f0",
			"shadow-color": "#4b4b4b7c",

			"background-color-accent": "rgba(var(--background-color-accent-values), 0.8)",
			"background-color-accent-values": "240, 242, 245",
			"background-color-contrast": "#4b4b4b",

			"border-color": "rgba(75, 75, 75, 0.2)",
			"border-color-solid": "#b3b3b3"
		},
		"dark": {
			"textColor": "#d8d8d8",
			"textColorContrast": "#000000",

			"bg_color_1": "28, 28, 28",
			"bg_color_2": "52, 52, 52",
			"bg_color_3": "75, 75, 75",
			"bg_color_4": "100, 100, 100",
			"bg_color_5": "125, 125, 125",
			"bg_color_6": "150, 150, 150",
			"text-color": "var(--text-color-white)",
			"svg-color": "var(--text-color)",
			"disabled-color": "#3d3d3d",
			"shadow-color": "#0a0a0a7c",
			"layoutBackgroundColor": "28, 28, 28",
			"layout-background-contrast": "255, 255, 255",
			"background-color-primary": "rgba(28, 28, 28, 0.8)",
			"background-color-primary-2": "#222222",
			"background-color-accent-values": "42, 42, 42",
			"background-color-accent": "rgba(42, 42, 42, 0.8)",
			"background-color-contrast": "#ffffff",
			"background_disabled": "#080808",
			"border-color": "rgba(180, 180, 180, 0.15)",
			"border-color-solid": "#3c3c3c",
			"header-text-color": "#d8d8d8",
			"button-background-color": "var(--colorPrimary)",
			"button-text-color": "var(--background-color-contrast)"
		}
	}
}
