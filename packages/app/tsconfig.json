{
	"compilerOptions": {
		"types": ["@types/audioworklet", "vite/client", "node"],
		"target": "es2024",
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": false,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"experimentalDecorators": false,
		"noFallthroughCasesInSwitch": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"paths": {
			"@/*": ["./src/*", "../../packages/spaces-sdk/src/*"],
			"@config/*": ["./config/*", "./config/*.json"],
			"@config": ["./config/index.js"],

			"@ui/*": ["./src/ui/*"],
			"@cores/*": ["./src/cores/*"],
			"@pages/*": ["./src/pages/*"],
			"@styles/*": ["./src/styles/*"],
			"@components/*": ["./src/components/*"],
			"@contexts/*": ["./src/contexts/*"],
			"@utils/*": ["./src/utils/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@classes/*": ["./src/classes/*"],
			"@endpoints/*": ["../../modules/comty.js/src/endpoints/*"],

			"comty.js/*": ["../../modules/comty.js/src/*"],
			"@ragestudio/vessel": ["../../modules/vessel/src/index.ts"],
			"@ragestudio/vessel/*": ["../../modules/vessel/src/*"],
			"@comty/shared/*": ["../shared/*"],
		},
	},
	"files": ["src/env.d.ts"],
	"include": [
		"./src/**/*.ts",
		"./src/**/*.js",
		"./src/**/*.tsx",
		"./src/**/*.jsx",
	],
}
