{
	"extends": "./node_modules/expo/tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": false,
		"esModuleInterop": true,

		"types": ["node"],
		"paths": {
			// fallback to the spaces sdk source so its internal "@/" imports resolve during typecheck
			// metro already resolves aliases per file in metro.config.js
			"@/*": ["./src/*", "../spaces-sdk/src/*"],
			"@/assets/*": ["./assets/*"],
		},
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
}
