		"@types/luxon": "^3.7.6",
		"@types/node": "^25.9.9",
		"@types/qrcode": "^1.5.6",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@vitest/coverage-v8": "^4.1.11",
		"chai": "^6.3.0",
		"eslint": "^10.12.0",
