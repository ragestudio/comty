{
	"name": "@comty/server",
	"version": "2.34.0@alpha",
	"license": "ComtyLicense",
	"type": "module",
	"private": true,
	"workspaces": [
		"services/*"
	],
	"aliases": {
		"@comty/shared": "../shared",
		"@db": "../shared/db"
	},
	"scripts": {
		"setup": "linebridge boot scripts/setup/index.js",
		"dev": "linebridge gateway",
		"dev:exp": "DEBUG=true ../../modules/linebridge/gateway/debug",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@comty/shared": "workspace:*",
		"@foxify/events": "^2.1.0",
		"@infisical/sdk": "^5.0.2",
