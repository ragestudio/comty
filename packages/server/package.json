		"@linebridge/engine-neo": "workspace:*",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/kv": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"@otplib/uri": "^13.5.0",
		"@ragestudio/scylla-odm": "0.22.19",
		"@sentry/node": "^10.76.1",
		"aws4fetch": "^1.0.20",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.81.5",
		"cross-env": "10.1.0",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"linebridge": "workspace:*",
		"lodash": "^4.18.1",
