{
	"$schema": "http://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"allowJs": true,
		"skipLibCheck": true,
		"paths": {
			"@shared-classes/*": ["./classes/*"],
			"@shared-middlewares": ["./middlewares/index.ts"],
			"@shared-middlewares/*": ["./middlewares/*"],
			"@shared-utils/*": ["./utils/*"],
			"@classes/*": [
				"./services/auth/classes/*",
				"./services/chats/classes/*",
				"./services/ems/classes/*",
				"./services/files/classes/*",
				"./services/groups/classes/*",
				"./services/main/classes/*",
				"./services/marketplace/classes/*",
				"./services/music/classes/*",
				"./services/notifications/classes/*",
				"./services/posts/classes/*",
				"./services/rtc/classes/*",
				"./services/search/classes/*",
				"./services/users/classes/*",
			],
			"@db_models": ["./db_models"],
			"@db_models/*": ["./db_models/*"],
			"@db/*": ["../shared/db/*"],
			"@services/*": ["./services/*"],
			"@comty/shared/*": ["../shared/*"],
		},
	},
	"include": ["**/*.ts"],
}
