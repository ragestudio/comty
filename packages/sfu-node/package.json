{
	"name": "sfu-node",
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "linebridge boot ./src/run.ts --watch",
		"start": "linebridge boot ./build/run.js",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.3.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@comty/shared": "workspace:*",
		"linebridge": "workspace:*",
		"@linebridge/engine-nats": "workspace:*",
		"@linebridge/cli": "workspace:*",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/kv": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"mediasoup": "^3.28.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "^7.0.2"
	}
}
