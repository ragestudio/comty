{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": false,
		"esModuleInterop": true,
	},
	"include": ["**/*.ts", "**/*.tsx"],
}
