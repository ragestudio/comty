FROM node:26-trixie-slim AS build

RUN mkdir -p /building
WORKDIR /building

COPY ./docs /building/docs
COPY ./docusaurus /building/docusaurus

RUN npm install --global corepack@latest
RUN corepack use pnpm@latest-12

WORKDIR /building/docusaurus

RUN pnpm install
RUN pnpm build

FROM node:26-trixie-slim AS runtime

# Create workdir
RUN mkdir -p /app
WORKDIR /app

COPY --from=build /building/docusaurus/server .
COPY --from=build /building/docusaurus/build ./public

RUN npm install --global corepack@latest
RUN corepack use pnpm@latest-12

RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production
CMD ["pnpm", "serve"]
